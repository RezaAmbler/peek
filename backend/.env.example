# ---------------------------------------------------------------------------
# Application security (required)
# ---------------------------------------------------------------------------

# SECRET_KEY signs JWT auth tokens. MUST be set to a long random value.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# The startup validator in core/config.py rejects empty values, known weak
# placeholders, and anything shorter than 32 characters.
SECRET_KEY=

# Password for the "admin" account created on first start (only read when no
# admin user exists yet; existing accounts are never changed). Needs 8+
# characters with upper- and lower-case letters and a digit.
# Leave empty to have a random password generated and printed once to the
# backend log. There is no built-in default such as admin/admin.
INITIAL_ADMIN_PASSWORD=

# bcrypt cost for password hashes (default 12). Accounts are re-hashed at the
# new cost on their next successful login.
# BCRYPT_ROUNDS=12

# Set DEBUG=true only in local development. NEVER in production.
DEBUG=false

# Allowed CORS origins. JSON list (note the quoting style).
ALLOWED_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/peek.db

# ---------------------------------------------------------------------------
# Celery / Redis broker
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Frontend URL (used in scheduled-scan email notification links)
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Outbound webhook / Slack push (optional)
# When set, a compact summary is POSTed after a scheduled scan that produced
# NEW critical findings or any KEV-listed (actively-exploited) findings.
# Suppressed / false-positive findings are excluded. Best-effort with a short
# timeout; a failure never affects the scan. Leave blank to disable each channel.
# requests honors HTTPS_PROXY from the environment automatically.
# ---------------------------------------------------------------------------
# Generic JSON webhook endpoint (receives the full structured payload):
WEBHOOK_URL=
# Slack-compatible incoming webhook (receives a text + blocks message):
# e.g. https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# SMTP email notifications (optional)
# Set SMTP_ENABLED=true to send emails on scheduled-scan completion.
# ---------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=noreply@peek-scanner.com
SMTP_FROM_NAME=PEEK Security Scanner
SMTP_USE_TLS=true

# Gmail Setup Instructions:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to Google Account > Security > App passwords
# 3. Generate an app password for "Mail"
# 4. Use the 16-character password (without spaces) as SMTP_PASSWORD
# 5. Set SMTP_USER to your Gmail address
# 6. Set SMTP_ENABLED=true

# Other SMTP Providers:
# SendGrid: smtp.sendgrid.net:587 (use API key as password)
# Mailgun: smtp.mailgun.org:587
# AWS SES: email-smtp.us-east-1.amazonaws.com:587
# Custom: Use your organization's SMTP server
